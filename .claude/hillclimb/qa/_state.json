{
  "flow": "qa",
  "description": "Filing Analyst Q&A: question -> hybrid search -> Claude with citations -> number check (POST /api/ask). Cases: eval/qa/cases.json.",
  "metrics": [
    { "id": "correct", "label": "Correct", "kind": "binary" },
    { "id": "supported", "label": "Claims backed", "kind": "judge" },
    { "id": "answered", "label": "Answered", "kind": "binary" },
    { "id": "unverified", "label": "Unverified #", "kind": "float" }
  ],
  "perf_fields": ["latency_s", "passages_sent", "sources_cited"],
  "prices": {
    "claude-haiku-5-5": { "in": 0.1, "out": 0.5 },
    "claude-sonnet-5-5": { "in": 2.0, "out": 10.0 },
    "claude-opus-5-5": { "in": 4.0, "out": 20.0 }
  },
  "harness_paths": [
    "eval/qa/cases.json",
    "src/lib/eval/grade.ts",
    "src/lib/qa/answer.ts",
    "src/lib/qa/ask.ts",
    "src/lib/qa/numbers.ts",
    "src/lib/qa/server-deps.ts",
    "src/lib/search/hybrid.ts",
    "src/lib/search/retrieve.ts"
  ]
}

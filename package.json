{
  "name": "filing-analyst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "supabase db push --remote",
    "db:new": "supabase migration new",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.ts",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.ts",
    "profile:coverage": "node --env-file-if-exists=.env.local scripts/profile-coverage.ts",
    "ingest:test-set": "node --env-file-if-exists=.env.local scripts/ingest-test-set.ts",
    "fixtures:save": "node --env-file-if-exists=.env.local scripts/save-fixtures.ts",
    "inspect:headings": "node scripts/inspect-headings.ts",
    "inspect:sections": "node scripts/inspect-sections.ts",
    "inspect:chunks": "node scripts/inspect-chunks.ts",
    "coverage": "node --env-file-if-exists=.env.local scripts/coverage.ts",
    "search": "node --env-file-if-exists=.env.local scripts/search.ts",
    "ask": "node --env-file-if-exists=.env.local scripts/ask.ts",
    "check:questions": "node --env-file-if-exists=.env.local scripts/check-questions.ts",
    "risks": "node --env-file-if-exists=.env.local scripts/risks.ts",
    "eval:cases": "node --env-file-if-exists=.env.local scripts/eval-generate-cases.ts",
    "eval": "node --env-file-if-exists=.env.local eval/qa/run-eval.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@supabase/supabase-js": "^2.119.2",
    "htmlparser2": "^12.0.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "type": "module"
}

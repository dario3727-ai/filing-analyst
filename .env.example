# Copy to .env.local and fill in. Never commit .env.local.
# Check it with: npm run check:env  (reports problems without printing values)

# SEC: app name and a contact email, required on every request
SEC_USER_AGENT="Filing Analyst your-email@example.com"

# Supabase (Project Settings > API Keys)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser: access is limited by
# row-level security. Older projects call this the "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server code and scripts only; never expose to the
# browser and never prefix with NEXT_PUBLIC_. Older projects call this the
# "service_role" key.
SUPABASE_SECRET_KEY=

# Claude API (Claude Console > API keys)
ANTHROPIC_API_KEY=

# Voyage AI embeddings (needed from milestone 3)
VOYAGE_API_KEY=

# Optional: /api/ask settings (defaults shown in comments)
# Model for new answers: haiku or sonnet (default: haiku in development, sonnet when deployed)
ASK_MODEL=
# New answers allowed per UTC day across all users (default: 50)
ASK_DAILY_LIMIT=

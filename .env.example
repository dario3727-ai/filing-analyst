# Copy to .env.local and fill in. Never commit .env.local.

# SEC: app name and a contact email, required on every request
SEC_USER_AGENT="Filing Analyst your-email@example.com"

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and scripts only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Claude Console > API keys)
ANTHROPIC_API_KEY=

# Voyage AI embeddings
VOYAGE_API_KEY=
